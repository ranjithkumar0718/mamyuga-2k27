* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f3f6ff;
    color: #333;
    line-height: 1.6;
}

/* Header */
header {
    background: linear-gradient(135deg, #4b0082, #6a11cb, #2575fc);
    color: white;
    text-align: center;
    padding: 45px 20px;
}

header h1 {
    font-size: 35px;
    margin-bottom: 10px;
}

header p {
    font-size: 14px;
    margin: 5px;
}

.btn {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 25px;
    background: white;
    color: #5b16b9;
    text-decoration: none;
    border-radius: 25px;
    font-weight: bold;
}

/* Sections */
section {
    max-width: 900px;
    margin: auto;
    padding: 40px 20px;
}

section h2 {
    text-align: center;
    color: #54208f;
    margin-bottom: 25px;
}

/* Cards */
.card {
    background: white;
    padding: 20px;
    margin: 15px 0;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.10);
    border-left: 4px solid #6a11cb;
}

/* Event Details */
.details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.details .card {
    text-align: center;
}

/* Events */
.events {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.events .card {
    margin: 0;
}

.events h3 {
    color: #54208f;
    font-size: 16px;
    margin-bottom: 10px;
}

.events p {
    font-size: 13px;
}

/* Registration Form */
.form-box {
    max-width: 500px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.12);
}

form label {
    display: block;
    margin-top: 12px;
    margin-bottom: 5px;
    font-weight: bold;
    font-size: 14px;
}

form input,
form select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    outline: none;
}

form input:focus,
form select:focus {
    border-color: #6a11cb;
}

form button {
    width: 100%;
    margin-top: 20px;
    padding: 12px;
    border: none;
    border-radius: 6px;
    background: #6a11cb;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

form button:hover {
    background: #4b0082;
}

/* Participants */
#participants {
    text-align: center;
}

/* Footer */
footer {
    background: #32105c;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}

/* Mobile Responsive */
@media (max-width: 600px) {

    header {
        padding: 35px 15px;
    }

    header h1 {
        font-size: 28px;
    }

    .details {
        grid-template-columns: 1fr;
    }

    .events {
        grid-template-columns: 1fr;
    }

    section {
        padding: 30px 15px;
    }

    .card {
        padding: 15px;
    }
}